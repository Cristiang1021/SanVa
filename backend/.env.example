# =============================================================================
# BACKEND — Sanva Shows (copia a .env en local / pega en Vercel → Environment)
# =============================================================================

# --- Turso (OBLIGATORIO en producción / Vercel) ---
# https://turso.tech → Database → Connect
TURSO_DATABASE_URL=libsql://tu-db-nombre-org.turso.io
TURSO_AUTH_TOKEN=

# --- JWT (OBLIGATORIO) ---
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Entorno ---
NODE_ENV=production
PORT=3000

# --- Superadmin inicial (id:1, solo se crea si la BD está vacía) ---
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=tu@correo.com
SUPERADMIN_PASSWORD=
SUPERADMIN_NOMBRE=Super Administrador

# --- URLs (OBLIGATORIO en producción) ---
# URL pública del frontend (sin barra final)
FRONTEND_URL=https://tu-frontend.vercel.app
# Orígenes permitidos por CORS (misma URL del front, separadas por coma si hay más)
CORS_ORIGIN=https://tu-frontend.vercel.app

# --- Email (opcional: respaldo si no configuras Gmail en el panel) ---
# EMAIL_USER=
# EMAIL_PASSWORD=
