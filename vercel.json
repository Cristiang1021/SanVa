{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/uploads/:path*", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/:file(.*\\.[a-zA-Z0-9]+)", "destination": { "service": "frontend" } },
    { "source": "/:path*", "destination": { "service": "frontend", "path": "/index.html" } }
  ]
}
